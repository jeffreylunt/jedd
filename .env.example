# Copy to .env and fill in.
OWNER_HANDLE=+15550000001
# Optional, dev only. scripts/replay-corpus.ts replays as OWNER using this handle
# instead of OWNER_HANDLE, because the live shadow runs with a synthetic owner.
# Unset means "replay as whoever OWNER_HANDLE names".
# JEDD_REPLAY_OWNER_HANDLE=

# 🔴 TWO ssh identities, and the separation IS the security boundary.
# admin  = privileged, has docker. Used ONLY by structured tools whose command
#          text is a literal in this repo.
# shell  = UNPRIVILEGED account on hp, NO docker group, NO sudo. Used ONLY by
#          hp_shell, the one tool where the model composes the command text.
# If these are equal, hp_shell is not registered at all.
HP_ADMIN_SSH_HOST=homelab
HP_SHELL_SSH_HOST=homelab-jedd-shell

LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3.8:27b

# Base URL must include the /jellyfin path prefix — the bare host 302s.
JELLYFIN_URL=http://10.0.0.10:8096/jellyfin
JELLYFIN_API_KEY=

DISPATCHARR_URL=http://10.0.0.10:9191

# 🔴 The DOCKER BRIDGE GATEWAY, not 10.0.0.10:8080. qBittorrent lives in
# gluetun-torrents' network namespace and its API is only reachable on the
# bridge address, from hp itself. Auth-bypass is on for that source, which is
# why there are no credentials here; a request from anywhere else gets
# Unauthorized, and that is not a bug.
QBITTORRENT_URL=http://172.20.0.1:8080

# Absent = read-only. Set to true ONLY deliberately.
# JEDD_ALLOW_WRITES=true
RUNBOOK_PATH=/path/to/homelab-access-inventory.md

# Arr access. Base URLs INCLUDE the path prefix -- the bare host serves a web app,
# so a wrong URL returns 200 + HTML and reads as a broken homelab rather than as a
# config error. V2 runs on the Mac, so these are the LAN address, not localhost.
#
# 🔴 An ABSENT key is not an absent capability: it produces a 401, which the tool
# correctly reports as UNKNOWN -- so the failure looks like an unreachable service
# rather than like missing config. Set these.
SONARR_URL=http://10.0.0.10:8989/sonarr/api/v3
SONARR_API_KEY=
RADARR_URL=http://10.0.0.10:7878/radarr/api/v3
RADARR_API_KEY=

# The Movie Database — the ONLY source of "what's popular". Neither arr can
# browse: both need a title. Free account at themoviedb.org/settings/api.
# 🔴 This is the v4 READ ACCESS TOKEN — a ~237-character JWT sent as a bearer —
#    NOT the 32-character v3 API key. Both authenticate against the same v3
#    endpoints, so either "works" and a wrong LENGTH here is the only tell that
#    one was pasted in place of the other. Copy it, never retype it.
# ⚠️ Empty or absent means `whats_popular` is NOT REGISTERED at all. That is
#    deliberate (no credential, no tool) and it is silent: the capability simply
#    will not exist, with no error to investigate. This line is where somebody
#    finds out it is available.
TMDB_READ_TOKEN=

# Where indexer_admin saves an indexer's full configuration BEFORE deleting it,
# which is what makes `remove` reversible. Optional: defaults to
# ~/.superbot2/backups/prowlarr-indexers. The files can hold tracker credentials
# and are written 0600 in a 0700 directory, so keep this OUT of the repo — a
# branch switch or a clean must not take the only copy of a deleted indexer.
# INDEXER_BACKUP_DIR=

# ── Where downloads are recorded before removal ──────────────────────────────
# Same idea as INDEXER_BACKUP_DIR: what stuck_downloads removed from the queue,
# captured first so the removal is reversible. Defaults to
# ~/.superbot2/backups/removed-downloads.
# DOWNLOAD_BACKUP_DIR=

# ── Identity ─────────────────────────────────────────────────────────────────
# The persona name, used in the SYSTEM PROMPT, in refusal text and in the ebook
# mail signature. Default: Jedd.
# ⚠️ The `[jedd]` log prefixes are deliberately NOT derived from this — every
#    runbook and knowledge file greps for them, so they stay constant across
#    deployments even when the persona is renamed.
# DISPLAY_NAME=Jedd

# ── Library placement (Sonarr / Radarr) ──────────────────────────────────────
# 🔴 A WRONG VALUE HERE DOES NOT ERROR. The *arr accepts it and files the show
#    or film into the wrong place at the wrong quality; nobody finds out until
#    somebody goes looking for it. Set these deliberately.
# Root folders must be paths as YOUR Sonarr/Radarr sees them (inside its own
# container, if it runs in one), not as this bot sees them.
# SONARR_ROOT_FOLDER=/media/tv
# RADARR_ROOT_FOLDER=/media/movies
# Quality profile IDs are per-instance: `9` is simply whichever profile is ninth
# on one particular Sonarr and means nothing on yours. Read them from
# Settings -> Profiles, or GET /api/v3/qualityprofile. Default 1 exists on every
# fresh install.
# SONARR_QUALITY_PROFILE_ID=1
# RADARR_QUALITY_PROFILE_ID=1

# ── qBittorrent ──────────────────────────────────────────────────────────────
# Two addresses on purpose. QBITTORRENT_URL is used only inside commands that
# run ON the download host (so it may be a docker-internal address);
# QBITTORRENT_LAN_URL is the one THIS process connects to directly.
# QBITTORRENT_URL=http://172.20.0.1:8080
# QBITTORRENT_LAN_URL=http://localhost:8080

# ── Audiobooks ───────────────────────────────────────────────────────────────
# 🔴 BOTH ARE REQUIRED AND THEY ARE NOT REDUNDANT: the category is what a mover
#    script watches, the save path is what actually places the file. A category
#    alone moves nothing. Paths are as qBittorrent sees them.
# AUDIOBOOK_SAVE_PATH=/downloads/audiobooks
# AUDIOBOOK_CATEGORY=audiobooks

# ── Live-TV channel health ───────────────────────────────────────────────────
# Where your check-streams script writes its results, ON the homelab host. This
# is an interface to a script this repo does not ship; leave it alone unless you
# run that script.
# ⚠️ Operator-supplied only — it is interpolated into a shell command over ssh.
# CHECK_STREAMS_RESULTS_PATH=/tmp/check-streams-results.txt

# ── IRC ebook fetching (only used when IRC_EBOOKS=1) ─────────────────────────
# 🔴 IRC_NICK MUST BE UNIQUE PER DEPLOYMENT. Two people running this against the
#    same network collide, and the server renames or rejects the second one.
# IRC_HOST=irc.irchighway.net
# IRC_PORT=6667
# IRC_CHANNEL=#ebooks
# IRC_NICK=jeddbot
# NOTE: the IRC TIMING constants are deliberately NOT configurable. The ~70s
# join delay and the 90s search timeout are measured properties of that
# server's behaviour (the 90s is pinned by a test above the slowest observed
# reply), not preferences — a "reasonable-looking" value silently breaks search.

# ── BlueBubbles: the iMessage channel (REQUIRED — nothing works without it) ──
# BlueBubbles must run on a Mac signed into the iMessage account this bot uses.
BLUEBUBBLES_URL=http://127.0.0.1:1234
BLUEBUBBLES_PASSWORD=
# 🔴 REQUIRED, NO DEFAULT, AND THE BOOT REFUSES WITHOUT IT. The Apple ID this
#    bot is supposed to be. Two BlueBubbles servers on one Mac accept the SAME
#    password and expose the SAME API, so a wrong port connects SUCCESSFULLY to
#    the wrong identity — this is asserted at boot so that cannot happen quietly.
BLUEBUBBLES_IDENTITY=
# Where WE listen for inbound webhooks.
# ⚠️ IN A CONTAINER SET THE HOST TO 0.0.0.0. The 127.0.0.1 default means the
#    container's own loopback, and the published port then reaches nothing.
# BLUEBUBBLES_WEBHOOK_HOST=127.0.0.1
# BLUEBUBBLES_WEBHOOK_PORT=18796
# BLUEBUBBLES_WEBHOOK_PATH=/webhook
# 🔴 What is REGISTERED with BlueBubbles — the address IT dials, which is not
#    necessarily the address we bind. Registrations dedupe by EXACT URL string,
#    so changing this string ADDS a second registration rather than replacing
#    the first, and BlueBubbles then fans out to both while silently dropping
#    the dead one's deliveries. Defaults to host:port+path.
# BLUEBUBBLES_WEBHOOK_URL=http://127.0.0.1:18796/webhook

# ── Prowlarr (indexer search + admin) ────────────────────────────────────────
# 🔴 THE BARE ROOT — no /api path prefix, unlike Sonarr and Radarr above.
PROWLARR_URL=http://10.0.0.10:9696
PROWLARR_API_KEY=

# ── Dispatcharr (live TV) — optional ─────────────────────────────────────────
# DISPATCHARR_USER=
# DISPATCHARR_PASSWORD=

# ── Send-to-Kindle (ebooks) — optional ───────────────────────────────────────
# 🔴 CHANGING KINDLE_FROM_EMAIL BREAKS EVERY EXISTING USER. Amazon matches the
#    sender against each recipient's own approved-senders list, so a new address
#    means silent E014 refusals until every user adds it. Pick once.
# ⚠️ SMTP password = an app password, not the account password.
# KINDLE_SMTP_HOST=smtp.gmail.com
# KINDLE_SMTP_PORT=587
# KINDLE_FROM_EMAIL=
# KINDLE_SMTP_PASSWORD=
# Delivery VERIFICATION reads the same mailbox over IMAP to find Amazon's
# bounces. Defaults to imap.gmail.com:993 and reuses KINDLE_SMTP_PASSWORD.
# Absent = sending still works, but a failure is never noticed.
# KINDLE_IMAP_HOST=imap.gmail.com
# KINDLE_IMAP_PORT=993
# KINDLE_IMAP_PASSWORD=

# ── IRC ebook source — off unless set to exactly "1" ─────────────────────────
# ⚠️ The join/UNAVAILABLE line in the log is the ONLY proof this flag took
#    effect: dotenv injects at runtime, so it never shows up in `ps` or
#    `docker inspect`.
# IRC_EBOOKS=1

# ── Reading finished downloads off the download host ─────────────────────────
# qBittorrent reports paths as ITS container sees them (e.g. /downloads/...);
# this is the matching prefix on the host, used to translate them. Empty means
# no translation, which yields file-not-found rather than a wrong file.
# EBOOK_HOST_DOWNLOAD_PREFIX=

# ── jfa-go (Jellyfin invites) — optional ─────────────────────────────────────
# ⚠️ An empty password means invite_to_jellyfin is NOT REGISTERED at all.
# JFAGO_URL=
# Only if the public invite surface is served on a different base than admin.
# JFAGO_PUBLIC_URL=
# JFAGO_USER=
# JFAGO_PASSWORD=
# JFAGO_PROFILE=Default
# JFAGO_INVITE_HOURS=24

# ── Escape hatch, deliberately awkward ───────────────────────────────────────
# Allows hp_shell to run on the SAME account as the admin identity. That
# collapses the privilege boundary above; the tool is disabled instead unless
# this is explicitly true.
# JEDD_ALLOW_SHARED_SSH_IDENTITY=true

# Only used when LLM_PROVIDER is a hosted API.
# LLM_API_KEY=

# ── 🔴 WHO THIS BOT IS ALLOWED TO TEXT — REQUIRED, AND IT FAILS CLOSED ───────
# There is no default and the process REFUSES TO BOOT without it. That is
# deliberate: the alternative to knowing the audience is guessing it, and the
# blast radius of guessing is "answers everyone who has ever texted this Mac".
#
#   everyone                  every sender. A real deployment.
#   +15551234567,+15559876543 exactly these handles; everyone else gets SILENCE
#                             rather than an untested answer. Use this while
#                             rehearsing against live traffic.
#
# ⚠️ Absence protects you only by stopping the boot — once this line exists it
#    is the ONLY thing between answering one person and answering all of them.
JEDD_SEND_TO=
