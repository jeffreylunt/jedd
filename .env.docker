# Container-only overrides. Loaded AFTER .env by docker-compose, so these win.
#
# This file deliberately contains NO credentials. .env stays the single source
# of truth for every key and password; all that changes in a container is the
# meaning of the word "localhost". Keeping the split this way means there is
# never a second copy of a secret to go stale or to leak.
#
# ── Why each line is here ───────────────────────────────────────────────────

# `localhost` inside a container is the CONTAINER, not the Mac. Both of these
# services run on the Mac's loopback, so they must be addressed through Docker
# Desktop's host alias. (192.0.2.20 — the Mac's LAN IP — also works and was
# measured working; host.docker.internal is preferred because it survives the
# Mac's LAN address changing.)
LLM_BASE_URL=http://host.docker.internal:11434
BLUEBUBBLES_URL=http://host.docker.internal:1234

# 🔴 BIND WIDE, ADVERTISE NARROW — these two are not the same address and the
# difference is the whole webhook.
#
# WEBHOOK_HOST is where the receiver BINDS *inside* the container. It defaults
# to 127.0.0.1, which inside a container means "the container's own loopback"
# and is unreachable from Docker's port forwarder — the mapped port would
# accept the connection and then find nothing listening. It must be 0.0.0.0.
#
# WEBHOOK_URL is what gets REGISTERED WITH BLUEBUBBLES, i.e. the address the
# Mac will dial. It must stay byte-identical to what the pm2 process registered,
# because BlueBubbles dedups registrations by exact URL string: a different
# string ADDS a second row rather than replacing the first, and it then fans out
# to both, dropping the dead one's POSTs silently at DEBUG level. Compose
# publishes the container port on the Mac's 127.0.0.1:18796, which is precisely
# what makes keeping this string unchanged both possible and correct.
BLUEBUBBLES_WEBHOOK_HOST=0.0.0.0
BLUEBUBBLES_WEBHOOK_PORT=18796
BLUEBUBBLES_WEBHOOK_URL=http://127.0.0.1:18796/webhook

# ── 🔴 THESE TWO DO NOT LIVE IN .env — THEY CAME FROM pm2's `env` BLOCK ─────
#
# ecosystem.config.cjs injected JEDD_SEND_TO and JEDD_ALLOW_WRITES directly,
# deliberately keeping them OUT of .env. Moving supervision from pm2 to Docker
# therefore has to carry them across explicitly, or the container is not the
# same bot. main.ts fails CLOSED without JEDD_SEND_TO — it refuses to boot at
# all rather than guess an audience — which is exactly how this gap was caught:
# the first container start crash-looped on it instead of quietly texting the
# wrong people. That guard did its job; do not defeat it by inventing a default.
#
# 🔴 JEDD_SEND_TO=everyone IS THE LIVE SETTING, NOT A TEST SETTING. It is the
# only thing standing between answering Jeff and answering everyone who texts.
# It is set here to match what pm2 was already running (the live boot line read
# "SEND AUDIENCE: everyone"), so this is parity, not a change. If you ever
# rehearse this container against live traffic, put a comma-separated handle
# list here FIRST — absence no longer protects you, it just stops the boot.
JEDD_SEND_TO=everyone

# Parity with pm2: the live boot line read "writes=ENABLED". With this false,
# every *arr write tool silently disappears from the registry and Jedd can look
# healthy while being unable to actually add anything.
JEDD_ALLOW_WRITES=true

# Unchanged from the host config, restated only to be explicit that the
# container is expected to run the real thing, not a degraded subset:
# IRC_EBOOKS, RUNBOOK_PATH, the *arr URLs and both SSH host aliases all come
# straight from .env and need no container-specific value — the LAN is directly
# reachable from the container (measured) and the SSH aliases are resolved by
# docker/ssh-config.
